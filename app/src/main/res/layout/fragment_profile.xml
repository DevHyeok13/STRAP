<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="내 정보"
        android:textColor="@color/text_title"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_profile_large"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/profile_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_profile_title" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_info_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#EAEAEA"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_profile_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_info_nickname"
                style="@style/ProfileInfoStyle"
                android:text="닉네임: 불러오는 중..."
                android:textStyle="bold" />

            <View style="@style/ProfileDividerStyle" />

            <TextView
                android:id="@+id/tv_info_name"
                style="@style/ProfileInfoStyle"
                android:text="이름: -" />

            <View style="@style/ProfileDividerStyle" />

            <TextView
                android:id="@+id/tv_info_gender"
                style="@style/ProfileInfoStyle"
                android:text="성별: -" />

            <View style="@style/ProfileDividerStyle" />

            <TextView
                android:id="@+id/tv_info_age"
                style="@style/ProfileInfoStyle"
                android:text="나이: -" />

            <View style="@style/ProfileDividerStyle" />

            <TextView
                android:id="@+id/tv_info_phone"
                style="@style/ProfileInfoStyle"
                android:layout_marginBottom="0dp"
                android:text="휴대전화: -" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_btn_logout_outline"
        android:text="로그아웃"
        android:textColor="#FF5252"
        android:textSize="15sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>