<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용자 정보"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_profile_large"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/profile_icon"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_profile_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_info_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_profile_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:id="@+id/tv_info_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="닉네임: 불러오는 중..."
                android:textSize="16sp"
                android:layout_marginBottom="15dp"
                android:textColor="#333333"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/tv_info_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이름: -"
                android:textSize="16sp"
                android:layout_marginBottom="15dp"
                android:textColor="#333333"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/tv_info_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="성별: -"
                android:textSize="16sp"
                android:layout_marginBottom="15dp"
                android:textColor="#333333"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/tv_info_age"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="나이: -"
                android:textSize="16sp"
                android:layout_marginBottom="15dp"
                android:textColor="#333333"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/tv_info_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="휴대전화: -"
                android:textSize="16sp"
                android:textColor="#333333"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="로그아웃"
        android:backgroundTint="#FF5252"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>