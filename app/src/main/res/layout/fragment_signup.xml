<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5"> <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <ImageView
        android:id="@+id/iv_signup_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_strap_not_string"
        android:contentDescription="앱 로고"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:id="@+id/layout_input_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@drawable/bg_signup_box"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/iv_signup_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/et_signup_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="아이디"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_check_duplicate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="중복확인"
                android:textSize="12sp"
                android:padding="0dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/et_signup_pw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="비밀번호"
            android:inputType="textPassword"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/et_signup_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="닉네임"
            android:inputType="text"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/et_signup_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="이름(실명)"
            android:inputType="text"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/et_signup_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="휴대전화(-없이)"
            android:inputType="phone"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/et_signup_gender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="성별 (남/여)"
            android:inputType="text"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/et_signup_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="나이"
            android:inputType="number"
            android:minHeight="48dp"
            android:layout_marginTop="15dp"
            android:background="@android:drawable/edit_text" />

    </LinearLayout> <Button
    android:id="@+id/btn_signup_complete"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:text="회원가입 &amp; 로그인"
    android:textSize="18sp"
    android:textStyle="bold"
    android:layout_marginTop="30dp"
    android:layout_marginBottom="30dp"
    app:layout_constraintTop_toBottomOf="@+id/layout_input_box"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>