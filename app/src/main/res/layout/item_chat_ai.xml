<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/iv_ai_profile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@mipmap/ic_launcher_round"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI 코치"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/tv_ai_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI가 답변하는 메시지입니다.\n여러 줄일 경우 이렇게 보입니다."
            android:textColor="#333333"
            android:background="@drawable/bg_signup_box"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/btn_add_routine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="내 맞춤 루틴에 추가 ➕"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#258578"
            android:backgroundTint="#FFFFFF"
            android:layout_marginTop="8dp"
            android:stateListAnimator="@null"
            android:visibility="gone" />

    </LinearLayout>
</LinearLayout>