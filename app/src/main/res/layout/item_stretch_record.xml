<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_signup_box"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <View
        android:layout_width="4dp"
        android:layout_height="36dp"
        android:layout_marginEnd="16dp"
        android:background="@color/strap_teal" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_stretch_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="거북목 교정 스트레칭"
            android:textColor="@color/text_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_stretch_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="2026.10.26 오후 2:30"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_stretch_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15분"
        android:textColor="#2196F3"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>