<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="타이머 설정"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <TextView android:text="운동 시간 (초)" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold"/>
    <EditText android:id="@+id/et_dialog_work" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>

    <TextView android:text="휴식 시간 (초)" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold"/>
    <EditText android:id="@+id/et_dialog_rest" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>

    <TextView android:text="세트 수" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold"/>
    <EditText android:id="@+id/et_dialog_sets" android:inputType="number" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>
</LinearLayout>