<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.STRAPxml" parent="Theme.AppCompat.DayNight.NoActionBar" />
    <style name="DayButtonStyle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:background">@drawable/selector_day_bg</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="ProfileInfoStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#444444</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="ProfileDividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#F1F1F1</item>
    </style>

    
</resources>