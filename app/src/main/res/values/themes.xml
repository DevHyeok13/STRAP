<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.STRAPxml" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/strap_teal</item>
        <item name="colorPrimaryVariant">@color/strap_teal</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">#2196F3</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <style name="DayButtonStyle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:background">@drawable/selector_day_bg</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ProfileInfoStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="ProfileDividerStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">#F5F5F5</item>
    </style>

</resources>